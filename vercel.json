{
  "installCommand": "echo 'static site — no install'",
  "buildCommand": "node scripts/write-mixpanel-config.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
